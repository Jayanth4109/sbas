# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key, for AI-generated product descriptions
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# A 4-6 digit PIN your dad will use to log into the inventory app
ADMIN_PIN=123456

# Random long string, used to sign the admin login cookie. Generate any random value.
SESSION_SECRET=change-this-to-a-random-string

# Your dad's WhatsApp Business number, in international format, no + or spaces
# e.g. 919876543210 for an Indian number
WHATSAPP_NUMBER=919876543210

# Shown on the storefront
NEXT_PUBLIC_STORE_NAME="Sri Babuji Ayurvedic Stores"
