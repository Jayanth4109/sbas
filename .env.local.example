# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter API key, for AI-generated product descriptions (uses a free model)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the free model used. Defaults to meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=

# A 4-6 digit PIN your dad will use to log into the inventory app
ADMIN_PIN=123456

# Random long string, used to sign the admin login cookie. Generate any random value.
SESSION_SECRET=change-this-to-a-random-string

# Your dad's WhatsApp number, in international format, no + or spaces
# e.g. 919876543210 for an Indian number. Public: it's used to build
# wa.me links from the browser, and shows up in that URL either way.
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Shown on the storefront
NEXT_PUBLIC_STORE_NAME="Sri Babuji Ayurvedic Stores"
